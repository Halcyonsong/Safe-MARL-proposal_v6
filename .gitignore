# Local training outputs: keep Markdown/JSON summaries, exclude raw artifacts.
# The local experiment tree is ~3.3 GB (data, checkpoints, logs); these are
# reproducible from nav/README_V6.md and are not part of the Git history.
*.npz
*.npy
*.pth
*.pt
*.pkl
*.ckpt
*.onnx
*.log
*.jsonl
*.pre_nanfix
*.failed_path
FAILED
nav/outputs/

# Raw per-scene evaluation chunks; the combined eval JSON is kept.
chunks_*/

# TensorBoard event files (training logs are reproducible).
events.out.tfevents.*

# TensorBoard / W&B local runs (root only; project output dirs may be named runs/)
/runs/
wandb/
lightning_logs/
